---
import { getCollection, type CollectionEntry } from 'astro:content';
import PostLayout from '../../../layouts/PostLayout.astro';
import { LANGUAGE_NAMES } from '../../../lib/language-colors';

export async function getStaticPaths() {
  const languagePosts = await getCollection('languages');
  
  return languagePosts.map((entry) => ({
    params: {
      lang: entry.data.language.toLowerCase(),
      concept: entry.data.concept.toLowerCase(),
    },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'languages'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();

// Breadcrumbs are built by PostLayout from the URL + frontmatter — don't
// duplicate them here (an earlier local copy linked the no-slash hub URL,
// which 301-redirects).
const languageDisplay = LANGUAGE_NAMES[entry.data.language] ?? entry.data.language;
---

<PostLayout frontmatter={entry.data}>
  <div class="language-badge">
    <span class="badge-text">{languageDisplay}</span>
  </div>
  <Content />
</PostLayout>

<style>
  .language-badge {
    display: inline-block;
    margin-bottom: var(--space-4);
    padding: var(--space-1) var(--space-3);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .badge-text {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-accent);
    font-weight: 500;
    text-transform: lowercase;
  }
</style>